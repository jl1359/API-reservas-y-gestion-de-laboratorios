generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Carrera {
  id       Int       @id @default(autoincrement())
  nombre   String    @db.VarChar(150)
  usuarios Usuario[]

  @@map("carreras")
}

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @db.VarChar(50)
  usuarios Usuario[]

  @@map("roles")
}

model Laboratorio {
  id              Int                       @id @default(autoincrement())
  nombre          String                    @unique @db.VarChar(100)
  capacidad       Int
  ubicacion       String?                   @db.VarChar(150)
  estadoOperativo String?                   @default("Activo") @map("estado_operativo") @db.VarChar(20)
  horarios        HorarioLaboratorio[]
  equipamientos   LaboratorioEquipamiento[]
  mantenimientos  Mantenimiento[]
  reservas        Reserva[]

  @@map("laboratorios")
}

model Equipamiento {
  id           Int                       @id @default(autoincrement())
  nombre       String                    @db.VarChar(150)
  tipo         String                    @db.VarChar(50)
  laboratorios LaboratorioEquipamiento[]

  @@map("equipamientos")
}

model Usuario {
  id             Int            @id @default(autoincrement())
  rolId          Int?           @map("rol_id")
  carreraId      Int?           @map("carrera_id")
  nombreCompleto String         @map("nombre_completo") @db.VarChar(200)
  correo         String         @unique @db.VarChar(150)
  passwordHash   String         @map("password_hash") @db.VarChar(255)
  activo         Boolean?       @default(true)
  auditorias     Auditoria[]
  notificaciones Notificacion[]
  reservas       Reserva[]
  solicitudesRol SolicitudRol[]
  carrera        Carrera?       @relation(fields: [carreraId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rol            Rol?           @relation(fields: [rolId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("usuarios")
}

model SolicitudRol {
  id            Int      @id @default(autoincrement())
  usuarioId     Int?     @map("usuario_id")
  rolSolicitado String   @map("rol_solicitado") @db.VarChar(50)
  estado        String?  @default("Pendiente") @db.VarChar(30)
  usuario       Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("solicitudes_rol")
}

model Auditoria {
  id        Int       @id @default(autoincrement())
  usuarioId Int?      @map("usuario_id")
  accion    String    @db.VarChar(255)
  fechaHora DateTime? @default(now()) @map("fecha_hora") @db.Timestamp(6)
  usuario   Usuario?  @relation(fields: [usuarioId], references: [id], onUpdate: NoAction)

  @@map("auditoria")
}

model HorarioLaboratorio {
  id            Int          @id @default(autoincrement())
  laboratorioId Int?         @map("laboratorio_id")
  dia           String       @db.VarChar(15)
  horaApertura  DateTime     @map("hora_apertura") @db.Time(6)
  horaCierre    DateTime     @map("hora_cierre") @db.Time(6)
  laboratorio   Laboratorio? @relation(fields: [laboratorioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("horarios_laboratorio")
}

model LaboratorioEquipamiento {
  id             Int           @id @default(autoincrement())
  laboratorioId  Int?          @map("laboratorio_id")
  equipamientoId Int?          @map("equipamiento_id")
  cantidad       Int
  equipamiento   Equipamiento? @relation(fields: [equipamientoId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  laboratorio    Laboratorio?  @relation(fields: [laboratorioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("laboratorio_equipamiento")
}

model Mantenimiento {
  id            Int          @id @default(autoincrement())
  laboratorioId Int?         @map("laboratorio_id")
  fechaInicio   DateTime     @map("fecha_inicio") @db.Timestamp(6)
  fechaFin      DateTime     @map("fecha_fin") @db.Timestamp(6)
  motivo        String
  laboratorio   Laboratorio? @relation(fields: [laboratorioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("mantenimientos")
}

model Reserva {
  id             Int          @id @default(autoincrement())
  usuarioId      Int?         @map("usuario_id")
  laboratorioId  Int?         @map("laboratorio_id")
  fechaInicio    DateTime     @map("fecha_inicio") @db.Timestamp(6)
  fechaFin       DateTime     @map("fecha_fin") @db.Timestamp(6)
  estado         String?      @default("Pendiente") @db.VarChar(30)
  tokenQr        String?      @unique @map("token_qr") @db.VarChar(255)
  horaAsistencia DateTime?    @map("hora_asistencia") @db.Timestamp(6)
  laboratorio    Laboratorio? @relation(fields: [laboratorioId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  usuario        Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("reservas")
}

model Notificacion {
  id            Int       @id @default(autoincrement())
  usuarioId     Int?      @map("usuario_id")
  mensaje       String
  leido         Boolean?  @default(false)
  fechaCreacion DateTime? @default(now()) @map("fecha_creacion") @db.Timestamp(6)
  usuario       Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("notificaciones")
}
