{
  "info": {
    "name": "API Trivago Campus Universitario (UMSS) - Sprint 1",
    "_postman_id": "c1a2b3c4-d5e6-7f8a-9b0c-1d2e3f4a5b6c",
    "description": "Colección completa de endpoints RESTful para la defensa del Sprint 1 de Servicios Telemáticos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Autenticación (HU-01, HU-03)",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@umss.edu\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (Docente)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"docente@umss.edu\",\n  \"password\": \"Docente123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Registro de Estudiante",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Estudiante Demo\",\n  \"correo\": \"demo.estudiante@umss.edu\",\n  \"password\": \"Demo1234!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Solicitud Recuperar Contraseña",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@umss.edu\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth", "forgot-password"] }
          }
        }
      ]
    },
    {
      "name": "2. Roles y Permisos (HU-02)",
      "item": [
        {
          "name": "Solicitar Rol (Estudiante)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rolSolicitado\": \"Docente\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/roles/request", "host": ["{{baseUrl}}"], "path": ["roles", "request"] }
          }
        },
        {
          "name": "Listar Solicitudes de Rol (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/roles/requests", "host": ["{{baseUrl}}"], "path": ["roles", "requests"] }
          }
        },
        {
          "name": "Gestionar Solicitud (Aprobar/Rechazar)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accion\": \"Aprobar\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/roles/manage/1", "host": ["{{baseUrl}}"], "path": ["roles", "manage", "1"] }
          }
        }
      ]
    },
    {
      "name": "3. Laboratorios y Búsqueda (HU-06, HU-12, HU-14)",
      "item": [
        {
          "name": "Listar Catálogo General (Público)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/laboratorios", "host": ["{{baseUrl}}"], "path": ["laboratorios"] }
          }
        },
        {
          "name": "Filtrar por Capacidad y Filtros Avanzados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/laboratorios?capacidadRequerida=20&tieneProyector=true",
              "host": ["{{baseUrl}}"],
              "path": ["laboratorios"],
              "query": [
                { "key": "capacidadRequerida", "value": "20" },
                { "key": "tieneProyector", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Obtener Detalle de Laboratorio por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/laboratorios/1", "host": ["{{baseUrl}}"], "path": ["laboratorios", "1"] }
          }
        },
        {
          "name": "Crear Laboratorio (Solo Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Laboratorio de Robótica y Automatización\",\n  \"capacidad\": 25,\n  \"ubicacion\": \"Bloque Electrónica, Aula 202\",\n  \"carreraId\": 1,\n  \"reservaPorComputadora\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/laboratorios", "host": ["{{baseUrl}}"], "path": ["laboratorios"] }
          }
        }
      ]
    },
    {
      "name": "4. Horarios y Calendario (HU-07, HU-13 - Responsable Miguel)",
      "item": [
        {
          "name": "Ver Calendario de Reservas del Laboratorio",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/laboratorios/1/calendario", "host": ["{{baseUrl}}"], "path": ["laboratorios", "1", "calendario"] }
          }
        },
        {
          "name": "Configurar Horarios Semanales (Solo Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"horarios\": [\n    { \"dia\": \"Lunes\", \"horaApertura\": \"08:00\", \"horaCierre\": \"12:00\" },\n    { \"dia\": \"Lunes\", \"horaApertura\": \"14:00\", \"horaCierre\": \"18:00\" },\n    { \"dia\": \"Martes\", \"horaApertura\": \"08:00\", \"horaCierre\": \"18:00\" },\n    { \"dia\": \"Miércoles\", \"horaApertura\": \"08:00\", \"horaCierre\": \"18:00\" },\n    { \"dia\": \"Jueves\", \"horaApertura\": \"08:00\", \"horaCierre\": \"18:00\" },\n    { \"dia\": \"Viernes\", \"horaApertura\": \"08:00\", \"horaCierre\": \"18:00\" }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/laboratorios/1/horarios", "host": ["{{baseUrl}}"], "path": ["laboratorios", "1", "horarios"] }
          }
        }
      ]
    },
    {
      "name": "5. Equipamientos (HU-08)",
      "item": [
        {
          "name": "Listar Equipamientos Base",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/equipamientos", "host": ["{{baseUrl}}"], "path": ["equipamientos"] }
          }
        },
        {
          "name": "Vincular Equipamiento a Laboratorio (Solo Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipamientoId\": 1,\n  \"cantidad\": 2\n}"
            },
            "url": { "raw": "{{baseUrl}}/equipamientos/laboratorio/1", "host": ["{{baseUrl}}"], "path": ["equipamientos", "laboratorio", "1"] }
          }
        }
      ]
    }
  ]
}
