            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  if (json.reserva && json.reserva.id) {",
                  "    pm.environment.set('reservaId', String(json.reserva.id));",
                  "  }",
                  "  if (json.reserva && json.reserva.tokenQr) {",
                  "    pm.environment.set('tokenQr', json.reserva.tokenQr);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
