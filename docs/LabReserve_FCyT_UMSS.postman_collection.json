            "body": {
              "mode": "raw",
              "raw": "{\n  \"laboratorioId\": 1,\n  \"fechaInicio\": \"2026-11-20T14:15\",\n  \"fechaFin\": \"2026-11-20T15:45\",\n  \"materia\": \"Servicios Telemáticos\",\n  \"cantidadAlumnos\": 25,\n  \"motivo\": \"Sesión práctica de laboratorio\",\n  \"recurrente\": false\n}"
            },
            "url": {
