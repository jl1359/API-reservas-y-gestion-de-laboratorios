                  "  }",
                  "  if (json.data && json.data.tokenQr) {",
                  "    pm.environment.set('tokenQr', json.data.tokenQr);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
